<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnSecondary"
    tools:context=".ui.details.DetailsFragment">

    <!-- Contenido principal con desplazamiento -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"


        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dim_60dp"
            > <!-- Espacio para la barra de acciones fija -->

            <!-- Imagen principal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/photoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:scaleType="centerCrop"
                    />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/progress"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    app:shimmer_auto_start="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/gray_100" />

                </com.facebook.shimmer.ShimmerFrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Información principal -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/bold"
                android:gravity="center_horizontal"
                android:text="@string/item_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/bold"
                android:gravity="center_horizontal"
                android:text="@string/item_company"
                android:textColor="?attr/colorControlNormal"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvPublicationDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/book"
                android:gravity="center_horizontal"
                android:text="@string/item_date"
                android:textColor="?attr/colorAccent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_job_type"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/item_type"
                android:textColor="?attr/colorSecondary"
                android:textSize="14sp" />

            <!-- Descripción del trabajo -->
            <com.google.android.material.card.MaterialCardView
                app:cardBackgroundColor="?attr/contentColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/bold"
                        android:text="@string/title_job_description"
                        android:textColor="@color/blue_300"
                        android:textSize="16sp"
                        app:drawableStartCompat="@drawable/ic_info" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/book"
                        android:text="@string/lorem"
                        android:textColor="@color/gray_600"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Información de la compañía -->
            <com.google.android.material.card.MaterialCardView
                android:textColor="?attr/colorPrimaryVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/bold"
                        android:text="@string/title_company_information"
                        android:textColor="?attr/colorPrimaryVariant"

                        android:textSize="16sp"
                        app:drawableStartCompat="@drawable/ic_work" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <!-- Información de la compañía -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_round_business_24"
                                app:tint="?attr/shadeGrey"
                                />

                            <TextView
                                android:id="@+id/tvCompanyData"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/item_company"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- Ubicación -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_outline_location_on_24"
                                app:tint="?attr/shadeGrey" />

                            <TextView
                                android:id="@+id/tvLocationData"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/item_location"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- Sitio web -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_baseline_public_24"
                                app:tint="?attr/shadeGrey" />

                            <TextView
                                android:id="@+id/tvWebsiteUrl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/item_companyurl"
                                android:textIsSelectable="true"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acciones fija en la parte inferior -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="@dimen/dim_10dp">

        <!-- Botón de favorito -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMark"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            app:icon="@drawable/ic_mark"
            app:iconTint="@color/green_200"
            app:cornerRadius="@dimen/dim_10dp"

            app:backgroundTint="@color/gray_700"
            />
        <!-- Botón de aplicar -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialButton.Custom"
            android:id="@+id/btnHowToApply"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            app:icon="@drawable/ic_help"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorSecondary"
            android:text="@string/txt_how_to_apply"

            />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>